# Lovable Cloud > Secrets. No VITE_ prefix: these are server-only settings.
# News location is automatic and independent from advertising consent.
# Set false only as an emergency kill switch.
LOCAL_MEDIA_CONTEXT_ENABLED=true
ADS_LOCATION_AUTO_ENABLED=false
DBIP_LITE_ENABLED=false
DBIP_FREE_API_ENABLED=true

# Profile/city lookup uses geo.api.gouv.fr without a key.
# Once validated, true above enables profile fallback; it does NOT enable unconfigured IP lookup.
# Do NOT assume Cloudflare headers reach Lovable functions from the frontend domain.
# Configure the following only after proving the gateway overwrites spoofed client values:
# LOCAL_MEDIA_TRUSTED_GEO_COUNTRY_HEADER=cf-ipcountry
# LOCAL_MEDIA_TRUSTED_GEO_REGION_HEADER=cf-region-code
# ADS_LOCATION_TRUSTED_GEO_COUNTRY_HEADER=cf-ipcountry
# ADS_LOCATION_TRUSTED_GEO_REGION_HEADER=cf-region-code
# ADS_LOCATION_TRUSTED_GEO_CITY_HEADER=cf-ipcity

# Free DB-IP City Lite MMDB, all ten name languages, compiled by scripts/geoip/build_dbip_lite.py.
# The private database is preferred. While it is unavailable, the news-only fallback uses
# api.db-ip.com over HTTPS and immediately reduces the response to city/region. Disable it
# with DBIP_FREE_API_ENABLED=false. No raw IP or coordinates are stored in discovery.
# CC BY 4.0 attribution remains visible in settings, news and sponsored cards.
# Private geoip-lite storage bucket in this SAME Lovable Cloud project (no public read/write policies).
# Upload an immutable release and verify its size fits the available FREE storage/egress quotas first.
# These values come from report.json. Rollback: false above, or pin a previous validated release/hash.
# DBIP_LITE_RELEASE=2026-10-<12-hex-source-hash>
# DBIP_LITE_MANIFEST_SHA256=<64-hex-manifest-hash>
# LOCAL_MEDIA_TRUSTED_IP_HEADER=<verified-overwritten-header>
# ADS_LOCATION_TRUSTED_IP_HEADER=<verified-overwritten-header>
