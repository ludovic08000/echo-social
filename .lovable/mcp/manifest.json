{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://vkpmoqfzrihcijjochks.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "forsure-mcp",
      "version": "0.1.0",
      "title": "ForSure"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my ForSure profile",
        "description": "Read the signed-in user's ForSure profile (name, bio, city, mood, creator status).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "update_my_profile",
        "title": "Update my ForSure profile",
        "description": "Update editable fields of the signed-in user's ForSure profile. Only provided fields change.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "description": "Display name.",
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "bio": {
              "description": "Short biography.",
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            },
            "city": {
              "description": "City shown on the profile.",
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            },
            "website_url": {
              "description": "Public website URL.",
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 300,
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            },
            "mood_emoji": {
              "description": "Mood emoji.",
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 8
                },
                {
                  "type": "null"
                }
              ]
            },
            "mood_text": {
              "description": "Short mood text.",
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_my_posts",
        "title": "List my ForSure posts",
        "description": "List the signed-in user's most recent ForSure posts with their like and comment counts.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "How many posts to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_post",
        "title": "Publish a ForSure post",
        "description": "Publish a text post (optionally with an image URL) on the signed-in user's ForSure feed. Can also be scheduled for later.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000,
              "description": "The post text."
            },
            "image_url": {
              "description": "Optional image URL to attach.",
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1000,
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            },
            "publish_at": {
              "description": "Optional ISO 8601 datetime to schedule the post instead of publishing immediately.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "body"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_notifications",
        "title": "List my ForSure notifications",
        "description": "List the signed-in user's recent ForSure notifications, optionally only the unread ones.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "unread_only": {
              "description": "Return only unread notifications (default false).",
              "type": "boolean"
            },
            "limit": {
              "description": "How many notifications to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
