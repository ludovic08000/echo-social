SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Origins exactes uniquement. Ajouter les domaines web et les schémas natifs utilisés.
AEGIS_ALLOWED_ORIGINS=https://forsure.fans,https://www.forsure.fans,capacitor://localhost,http://localhost

PORT=8787
AEGIS_TRUST_PROXY=true
AEGIS_AUTH_TIMEOUT_MS=8000
AEGIS_REQUEST_TIMEOUT_MS=20000
AEGIS_READINESS_TIMEOUT_MS=5000
AEGIS_MAX_BODY_BYTES=1048576
AEGIS_RATE_WINDOW_MS=60000
AEGIS_RATE_LIMIT_PER_IP=180
AEGIS_RATE_LIMIT_PER_USER=300
AEGIS_MAX_CONCURRENT_REQUESTS=200
AEGIS_SHUTDOWN_GRACE_MS=10000
